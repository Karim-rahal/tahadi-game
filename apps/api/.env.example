# Backend (apps/api) — copy to apps/api/.env for local dev, or set on Railway.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/darundi?schema=public"
NODE_ENV="development"
PORT="4000"
FRONTEND_URL="http://localhost:3000"
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string"
ADMIN_TOKEN="change-me-admin-token"
