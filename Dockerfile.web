# Frontend (Next.js) — build from the repo root as context.
# Railway: create a service, set its Dockerfile path to "Dockerfile.web".
FROM node:20-slim

WORKDIR /app

# NEXT_PUBLIC_* must be present at BUILD time (baked into the client bundle).
# On Railway set a build-time variable NEXT_PUBLIC_API_URL = https://<api-domain>
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

COPY . .
RUN npm install --no-audit --no-fund
RUN npm run build -w @darundi/web

ENV NODE_ENV=production
EXPOSE 3000

# `next start` honors Railway's injected PORT (see apps/web/package.json).
CMD ["sh", "-c", "npm run start -w @darundi/web"]
