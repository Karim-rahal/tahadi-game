# ───────────────────────────────────────────────────────────────
# تحدي الدروندي — Environment variables (example)
# Copy to .env for local dev. On Railway, set these per service.
# NEVER commit a real .env. NEVER expose DATABASE_URL via NEXT_PUBLIC_*.
# ───────────────────────────────────────────────────────────────

# ---- Backend (apps/api) ----
# PostgreSQL connection string (Railway provides this automatically as a
# service reference: ${{Postgres.DATABASE_URL}}).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/darundi?schema=public"

# Node environment: development | production | test
NODE_ENV="development"

# Port the Express API listens on (Railway injects PORT automatically).
PORT="4000"

# Public URL of the frontend. Used to lock down CORS and cookies.
# Local dev: http://localhost:3000 ; Railway: https://<web>.up.railway.app
FRONTEND_URL="http://localhost:3000"

# Secret used to sign/hash anonymous judge-session capability tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Admin token guarding destructive/question-admin endpoints (edit/disable).
# Generate the same way as SESSION_SECRET.
ADMIN_TOKEN="change-me-admin-token"

# ---- Frontend (apps/web) ----
# Public base URL of the backend API, exposed to the browser.
# Local dev: http://localhost:4000 ; Railway: https://<api>.up.railway.app
NEXT_PUBLIC_API_URL="http://localhost:4000"
